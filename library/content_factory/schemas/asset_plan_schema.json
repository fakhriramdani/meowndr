{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetPlan",
  "type": "object",
  "required": [
    "environment",
    "presenter",
    "color_tokens",
    "provenance_audit_passed"
  ],
  "properties": {
    "environment": {
      "type": "object",
      "required": ["id", "path", "floor_y"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "floor_y": { "type": "number" },
        "mood": { "type": "string" }
      }
    },
    "environments": {
      "type": "array",
      "description": "Multi-environment list for episodes utilizing diverse scene settings",
      "items": {
        "type": "object",
        "required": ["id", "path", "floor_y"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "floor_y": { "type": "number" },
          "mood": { "type": "string" },
          "used_in_scenes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "presenter": {
      "type": "object",
      "required": ["character", "states_used"],
      "properties": {
        "character": { "type": "string", "enum": ["CatScientist"] },
        "states_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accessories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "reusable_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "custom_props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "style"],
        "properties": {
          "name": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    },
    "color_tokens": {
      "type": "object",
      "required": ["primary", "secondary", "paper_cream"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "paper_cream": { "type": "string" },
        "paper_kraft": { "type": "string" }
      }
    },
    "provenance_audit_passed": { "type": "boolean" }
  }
}
