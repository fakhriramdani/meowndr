{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CaptionsSchema",
  "description": "Multi-Platform Caption Bundle Schema for Instagram Reels, TikTok, and YouTube Shorts",
  "type": "object",
  "required": [
    "topic",
    "language",
    "platforms"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "Final video topic"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "Language code (default 'id')"
    },
    "script_hash": {
      "type": "string",
      "description": "SHA-256 hash of script text used for generation"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO timestamp of caption generation"
    },
    "platforms": {
      "type": "object",
      "required": [
        "instagram",
        "tiktok",
        "youtube"
      ],
      "properties": {
        "instagram": {
          "type": "object",
          "required": [
            "caption",
            "hashtags",
            "character_count",
            "status"
          ],
          "properties": {
            "caption": {
              "type": "string",
              "maxLength": 2200
            },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 5
            },
            "character_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2200
            },
            "status": {
              "type": "string",
              "enum": ["READY", "NEEDS_REVIEW"]
            },
            "validation_errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "tiktok": {
          "type": "object",
          "required": [
            "caption",
            "hashtags",
            "character_count",
            "status"
          ],
          "properties": {
            "caption": {
              "type": "string",
              "maxLength": 2200
            },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 10
            },
            "character_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2200
            },
            "status": {
              "type": "string",
              "enum": ["READY", "NEEDS_REVIEW"]
            },
            "validation_errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "youtube": {
          "type": "object",
          "required": [
            "title",
            "description",
            "hashtags",
            "title_character_count",
            "description_character_count",
            "status"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "maxLength": 5000
            },
            "hashtags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "title_character_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "description_character_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "status": {
              "type": "string",
              "enum": ["READY", "NEEDS_REVIEW"]
            },
            "validation_errors": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
