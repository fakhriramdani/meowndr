{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchDossier",
  "type": "object",
  "required": [
    "topic",
    "niche",
    "verification_status",
    "claims",
    "generated_at"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "niche": {
      "type": "string",
      "enum": ["science", "history", "geography", "technology", "mystery", "psychology"]
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "PENDING", "REJECTED"]
    },
    "generated_at": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "sources"],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string", "minLength": 5 },
          "explanation": { "type": "string" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "publisher": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
