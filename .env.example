# Papercraft Content Factory Environment Configuration Example
# Copy this file to .env and configure your secrets:
#   cp .env.example .env

# TTS Provider Selection: 'elevenlabs' (primary), 'qwen3', or 'placeholder'
TTS_PROVIDER=elevenlabs

# ElevenLabs API Credentials (https://elevenlabs.io/app/settings/api-keys)
# Grant Text-to-Speech permission for the key.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID
# Standard pre-made voice accessible across all account tiers:
#   pNInz6obpgDQGcFmaJgB (Adam)
#   21m00Tcm4TlvDq8ikWAM (Rachel)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ElevenLabs Multilingual Model
# Supported Indonesian-compatible models:
#   eleven_multilingual_v2 (recommended for natural cadence & emotional range)
#   eleven_flash_v2_5 (ultra-fast generation)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ==============================================================================
# Trend Research & Content Intelligence API Configuration (Optional)
# If unconfigured, the system automatically falls back to public discovery tools
# ==============================================================================

# YouTube Data API v3 (Google Cloud Console: https://console.cloud.google.com)
# Used for querying trending shorts, video statistics (views, likes, comments)
# Quota: 10,000 units/day default (1 unit for videos.list, 100 units for search.list)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok Research API / Commercial API (https://developers.tiktok.com)
# Note: TikTok Research API is restricted to accredited academic institutions.
# TikTok Commercial API requires TikTok for Business Developer account.
# TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# Meta Graph API / Instagram Graph API (https://developers.facebook.com)
# Note: Meta Graph API is scoped to owned accounts and does not provide public Reels discovery.
# INSTAGRAM_GRAPH_API_KEY=your_instagram_graph_token_here

# ==============================================================================
# @meowndr Studio UI & Single-Admin Authentication (Opsi B: *.ramdanistudio.com)
# ==============================================================================
STUDIO_ENV=production
STUDIO_DOMAIN=reels.ramdanistudio.com
TRUSTED_ORIGINS=https://reels.ramdanistudio.com
STUDIO_ADMIN_EMAIL=creator@ramdanistudio.com
# Generate bcrypt hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
STUDIO_ADMIN_PASSWORD_HASH=$2b$12$replace_with_real_bcrypt_hash
STUDIO_JWT_SECRET=replace_with_64_char_random_secret
STUDIO_COOKIE_SECURE=true


